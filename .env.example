# Core app config
PROJECT_NAME="Dilla University AI Lost-and-Found System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:4173"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Security
SECRET_KEY="replace-with-a-long-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="postgresql+psycopg2://dilla:dilla_pass@db:5432/dilla_lost_found"

# Storage
UPLOAD_DIR="./backend/uploads"

# AI weights
WEIGHT_IMAGE=0.45
WEIGHT_TEXT=0.35
WEIGHT_METADATA=0.20
THRESHOLD_DIRECT_MATCH=0.80
THRESHOLD_OFFICER_REVIEW=0.52
