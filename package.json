{
  "name": "dilla-lost-and-found",
  "private": true,
  "scripts": {
    "dev": "concurrently \"cd backend && ./venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000\" \"cd frontend && npm run dev -- --host 0.0.0.0 --port 4173\"",
    "backend": "cd backend && ./venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "frontend": "cd frontend && npm run dev -- --host 0.0.0.0 --port 4173",
    "build": "cd frontend && npm run build",
    "test": "cd backend && ./venv/bin/python -m pytest -q"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
